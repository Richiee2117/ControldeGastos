<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Nombre -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.ControlDeGastos.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:hint="@string/nombre">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textSize="17sp"
            android:textColor="?attr/colorOnSurface"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:letterSpacing="0.01" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Monto -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.ControlDeGastos.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:hint="@string/monto"
        app:prefixText="$"
        app:prefixTextColor="@color/primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtMonto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textSize="17sp"
            android:textColor="?attr/colorOnSurface"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:letterSpacing="0.01" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Fecha -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.ControlDeGastos.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:hint="@string/fecha_contratacion">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            android:inputType="date"
            android:textSize="17sp"
            android:textColor="?attr/colorOnSurface"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:letterSpacing="0.01" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Frecuencia Spinner Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/primary"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/frecuencia"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerFrecuencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minHeight="56dp"
                android:background="@drawable/bg_spinner"
                android:popupBackground="@color/surface"
                android:dropDownSelector="@color/primary"
                style="@style/Widget.ControlDeGastos.Spinner" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Descripción -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.ControlDeGastos.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/descripcion">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:minLines="2"
            android:textSize="17sp"
            android:textColor="?attr/colorOnSurface"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:letterSpacing="0.01" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>

